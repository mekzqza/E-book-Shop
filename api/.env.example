# For running the API outside docker (npm run dev / npm test). Copy to api/.env
DATABASE_URL=postgresql://ebook:change-me@localhost:5432/ebook
PUBLIC_API_URL=http://localhost:4000
PORT=4000
# only for `npm run dev` of web + api without nginx
CORS_ORIGIN=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=E-book Shop <no-reply@example.com>
