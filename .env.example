# Copy to .env (docker compose reads it). Never commit .env.
POSTGRES_USER=ebook
POSTGRES_PASSWORD=change-me-url-safe-chars-only
POSTGRES_DB=ebook

# Public base URL of the API: used in download links and baked into the web build.
# Everything-in-compose: https://localhost. API-only server: https://api.your-domain.com
PUBLIC_API_URL=https://localhost

# The one browser origin nginx allows through CORS (the Vercel deployment)
ALLOWED_ORIGIN=https://your-app.vercel.app

# Leave SMTP_HOST empty to print emails to the api container log instead of sending
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=E-book Shop <no-reply@example.com>
